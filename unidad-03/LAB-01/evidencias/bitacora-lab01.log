	    id_evento        BIGSERIAL PRIMARY KEY,
	    momento          TIMESTAMPTZ NOT NULL DEFAULT now(),
	    usuario_sesion   TEXT        NOT NULL DEFAULT session_user,
	    usuario_efectivo TEXT        NOT NULL DEFAULT current_user,
